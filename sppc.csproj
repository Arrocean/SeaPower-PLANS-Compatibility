<Project DefaultTargets="Build">
  <PropertyGroup>
    <PackageDir Condition="'$(PackageDir)' == ''">$(MSBuildProjectDirectory)\Workshop\sppc</PackageDir>
  </PropertyGroup>

  <Target Name="Restore" />

  <Target Name="Build">
    <ItemGroup>
      <WorkshopContent Include="$(MSBuildProjectDirectory)\WorkshopSource\**\*" />
    </ItemGroup>
    <Delete Files="$(PackageDir)\sppc.dll" />
    <Copy SourceFiles="@(WorkshopContent)"
          DestinationFiles="@(WorkshopContent->'$(PackageDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
